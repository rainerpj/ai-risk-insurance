# Publish only application source, tests and build inputs.
/*
!/.gitignore
!/demo/
!/prototype/
/demo/*
!/demo/*.js
!/demo/*.cjs
!/demo/*.html
!/demo/*.css
/prototype/*
!/prototype/.gitignore
!/prototype/.node-version
!/prototype/package.json
!/prototype/pnpm-lock.yaml
!/prototype/pnpm-workspace.yaml
!/prototype/tsconfig.json
!/prototype/hardhat.config.ts
!/prototype/contracts/
!/prototype/packages/
!/prototype/scripts/
!/prototype/tests/
!/prototype/web/
!/prototype/fixtures/
# Never publish local data, credentials, docs or generated run outputs.
**/node_modules/
**/.local/
**/.env
**/.env.*
**/*.md
**/*.pdf
**/*.docx
**/*.pptx
**/*.xlsx
**/*.log
**/*.sqlite*
**/*.db
**/*.pem
**/*.key
**/reports/
**/deployments/
**/exports/
**/artifacts/
**/cache/
**/__pycache__/
